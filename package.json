  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "keywords": ["ai-agents", "mcp", "model-context-protocol", "compatibility", "product-compatibility", "shopping-agent", "agentic-commerce", "recalls", "x402", "function-calling", "tool-use", "ucp", "acp"],
  "homepage": "https://tetheredtrust.com/agents",
  "repository": { "type": "git", "url": "git+https://github.com/tetheredtrust/tethered-trust-js.git" },
  "bugs": { "url": "https://github.com/tetheredtrust/tethered-trust-js/issues" },
